# 配置说明模板（可提交）。复制为 .env.local 后填写；.env.local 与 .env 都不进仓库。
# 所有项都有代码内置默认值（apps/server/src/config.ts），不配任何文件也能启动。
# 加载优先级：真实环境变量 > .env.local > .env

# AI 模型：任意 OpenAI 兼容服务。默认关闭（走本地 FAQ/规则），不填 AI_API_KEY 同样走本地规则。
# AI_ENABLED=true
# AI_API_KEY=
# 预设厂商（自带接口地址与默认模型）：
# openai / deepseek / anthropic / gemini / zhipu / moonshot / qwen
# openrouter / groq / github / siliconflow / xai / ollama / custom
# 不设时按 AI_BASE_URL 推断，都没有则为 openai
# AI_PROVIDER=deepseek
# 以下两项可选，用于覆盖预设；custom 或自建网关时必填 AI_BASE_URL
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# 人工接管：客服静默 N 分钟后自动交还 AI（默认 10，0 = 永不交还）；接管期间状态提示的最小间隔（默认 5）
# HANDOFF_IDLE_RELEASE_MINUTES=10
# HANDOFF_NOTICE_COOLDOWN_MINUTES=5

# Server
# PORT=3001
# JWT 签名密钥。留空时自动生成并持久化到 DATA_DIR/.auth_secret（重启复用）。
# 多实例部署务必显式设置统一值（否则各实例 token 互不认）。生成：openssl rand -hex 32
# AUTH_SECRET=
# 反向代理层数/配置（Express trust proxy）：不设则不信任 x-forwarded-* 头
# TRUST_PROXY=1
# CORS 白名单（逗号分隔）；留空则放开（公开 widget 需跨站调用）。
# CORS_ORIGINS=https://yoursite.com,https://app.yoursite.com
# 存量 widget 灰度：放行不带访客令牌的会话读取/续写，升级完成后删除
# ALLOW_ANON_SESSION_READ=false
# 持久化写失败告警 webhook（POST {text}）
# ALERT_WEBHOOK_URL=

# 数据持久化：DB_DRIVER = sqlite（默认）| postgres | memory；不设时配了 DATABASE_URL → postgres，否则 sqlite
# DB_DRIVER=sqlite
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# SQLITE_PATH=
# DATA_DIR=

# 内置静态站点开关（默认全开）：demo=根路径演示站，widget=/widget，workstation=/workstation
# DEMO_ENABLED=true
# WIDGET_ENABLED=true
# WORKSTATION_ENABLED=true
